# GreenGuardians Production Environment Variables
# Copy this to .env.production and fill in actual values
# Or set these in your deployment platform (Railway, Render, etc.)

# Security - MUST CHANGE (generate with command below)
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-production-secret-key-here

# CRITICAL: Must be False in production
DEBUG=False

# Deployment - Replace with your actual domains
ALLOWED_HOSTS=your-backend.railway.app,api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com

# MongoDB Database - Use MongoDB Atlas (512 MB free forever)
# Get this from MongoDB Atlas dashboard
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=greenguardian

# Optional: Hugging Face token for faster model downloads (optional)
# HF_TOKEN=your_huggingface_token_here
